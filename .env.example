# Copy to .env and adjust for a real deployment. docker-compose reads this
# automatically. All values here have safe local defaults if left unset.

POSTGRES_USER=alta
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=alta
DB_PORT=5432

# For a real pilot: SITE_ADDRESS=alta.example-hotel.com — Caddy handles TLS
# automatically. Leave as http://:80 for local docker-compose testing.
SITE_ADDRESS=http://:80
WEB_PORT=8080
WEB_TLS_PORT=8443

# Unset = mock PMS / rule-based NLU / no real WhatsApp send (see docs/PRD.md §11).
PMS_PROVIDER=mock
NLU_PROVIDER=rule_based
ANTHROPIC_API_KEY=
ASR_PROVIDER=
AUTO_APPROVE_INTENTS=

# Signs dashboard staff login tokens — unset falls back to an insecure
# hardcoded dev value with a warning logged. Generate a real one for
# anything beyond local dev: `openssl rand -base64 32`.
JWT_SECRET=

# PMS_PROVIDER=mews wires in the real MewsPMSAdapter — defaults are Mews's
# own published public demo credentials, safe to use as-is for local
# testing (see apps/api/src/modules/pms/mewsAdapter.ts).
MEWS_PLATFORM_ADDRESS=https://api.mews-demo.com
MEWS_CLIENT_TOKEN=
MEWS_ACCESS_TOKEN=
MEWS_CLIENT_NAME=

# WHATSAPP_PROVIDER=cloud_api (default) is the only transport a real pilot
# should ever use. "waha" is a dev/demo-only alternative that needs no BSP
# approval but carries a real risk of the connected number being banned by
# WhatsApp — never point it at a real guest-facing number (see
# apps/api/src/modules/whatsapp/wahaGateway.ts). Start it with
# `docker compose --profile dev up`.
WHATSAPP_PROVIDER=cloud_api
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=alta-dev-verify-token
WAHA_SESSION=default
WAHA_API_KEY=
WAHA_PORT=3210
WAHA_PROPERTY_ID=demo-property
