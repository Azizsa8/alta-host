# Copy to .env and adjust for a real deployment. docker-compose reads this
# automatically. All values here have safe local defaults if left unset.

POSTGRES_USER=alta
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=alta
DB_PORT=5432

# For a real pilot: SITE_ADDRESS=alta.example-hotel.com — Caddy handles TLS
# automatically. Leave as http://:80 for local docker-compose testing.
SITE_ADDRESS=http://:80
WEB_PORT=8080
WEB_TLS_PORT=8443

# Unset = mock PMS / rule-based NLU / no real WhatsApp send (see docs/PRD.md §11).
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=alta-dev-verify-token
PMS_PROVIDER=mock
AUTO_APPROVE_INTENTS=
