DATABASE_URL="postgresql://alta:devpassword@localhost:5432/alta"
PORT=4317

# Signs dashboard staff login tokens (see modules/auth/tokens.ts) — unset
# falls back to an insecure hardcoded dev value with a warning logged.
# Generate a real one for anything beyond local dev: `openssl rand -base64 32`.
JWT_SECRET=

# Real integrations plug in via these — unset in local/demo mode, where the
# mock PMS adapter and rule-based intent engine are used instead.
PMS_PROVIDER=mock
ANTHROPIC_API_KEY=

# "rule_based" (default) uses the regex/keyword IntentEngine — no API key
# needed. "llm" uses the Anthropic-backed IntentEngine (see modules/nlu/
# llmEngine.ts); requires ANTHROPIC_API_KEY above, otherwise falls back to
# rule_based with a warning logged.
NLU_PROVIDER=

# "whisper" enables self-hosted, open-weights Whisper transcription for
# inbound voice messages (@xenova/transformers, no external account) — see
# modules/asr/whisperEngine.ts. Unset means voice messages are acked but not
# processed.
ASR_PROVIDER=

# WHATSAPP_PROVIDER=cloud_api (default) is the only transport a real pilot
# should ever use. "waha" is a dev/demo-only alternative that needs no BSP
# approval but carries a real risk of the connected number being banned by
# WhatsApp — never point it at a real guest-facing number (see
# modules/whatsapp/wahaGateway.ts).
WHATSAPP_PROVIDER=cloud_api
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=alta-dev-verify-token
WAHA_BASE_URL=
WAHA_SESSION=default
WAHA_API_KEY=

# PMS_PROVIDER=mews wires in the real MewsPMSAdapter (modules/pms/
# mewsAdapter.ts) — defaults below are Mews's own published public demo
# credentials (docs.mews.com/connector-api), safe to use as-is for local
# testing. A real pilot needs its own property's credentials.
MEWS_PLATFORM_ADDRESS=https://api.mews-demo.com
MEWS_CLIENT_TOKEN=
MEWS_ACCESS_TOKEN=
MEWS_CLIENT_NAME=

# Redis backs the inbound-message queue (BullMQ) and the live event feed
# (pub/sub → SSE). Local dev: docker compose up -d redis.
REDIS_URL=redis://localhost:6379

# "mastra" routes intent dispatch through the Mastra workflow runtime
# (durable suspend/resume review gate). Anything else = legacy switch.
ORCHESTRATOR=legacy
