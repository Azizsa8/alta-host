DATABASE_URL="postgresql://alta:devpassword@localhost:5432/alta"
PORT=4317

# Real integrations plug in via these — unset in local/demo mode, where the
# mock PMS adapter and rule-based intent engine are used instead.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=alta-dev-verify-token
PMS_PROVIDER=mock
ANTHROPIC_API_KEY=

# "rule_based" (default) uses the regex/keyword IntentEngine — no API key
# needed. "llm" uses the Anthropic-backed IntentEngine (see modules/nlu/
# llmEngine.ts); requires ANTHROPIC_API_KEY above, otherwise falls back to
# rule_based with a warning logged.
NLU_PROVIDER=
