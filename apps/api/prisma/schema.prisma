// ALTA MVP data model — mirrors the core entity set from the architecture doc.
// Postgres everywhere (dev via docker-compose's db service, prod the same
// image) so dev never drifts from what's actually deployed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id          String   @id @default(uuid())
  name        String
  pmsType     String   @default("mock")
  createdAt   DateTime @default(now())

  guests        Guest[]
  staff         StaffMember[]
  reservations  Reservation[]
  reviews       Review[]
  credentials   PropertyCredential[]
}

model Guest {
  id                String   @id @default(uuid())
  propertyId        String
  property          Property @relation(fields: [propertyId], references: [id])
  whatsappId        String   @unique
  name              String?
  preferredDialect  String   @default("saudi")
  // The real PMS's own customer id (e.g. Mews CustomerId), once correlated.
  // Populated by a reservation-sync process, not by MewsPMSAdapter itself —
  // the Connector API has no way to look a customer up by phone number, so
  // this correlation has to happen in the PMS-to-app direction (importing
  // upcoming reservations) before a guest ever messages on WhatsApp. Null
  // until that sync exists; MewsPMSAdapter degrades gracefully when it is.
  externalId        String?  @unique
  createdAt         DateTime @default(now())

  reservations   Reservation[]
  conversations  Conversation[]
}

model Reservation {
  id          String   @id @default(uuid())
  guestId     String
  guest       Guest    @relation(fields: [guestId], references: [id])
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  roomNumber  String
  checkIn     DateTime
  checkOut    DateTime
  status      String   @default("confirmed")
}

model StaffMember {
  id           String   @id @default(uuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id])
  name         String
  role         String   // reception | housekeeping | maintenance | manager
  onShift      Boolean  @default(true)
  whatsappId   String?
  // Dashboard login — both null means this staff record can't log in (e.g.
  // housekeeping/maintenance staff who only ever appear as a ticket
  // assignee, never open the Command Center themselves).
  username     String?  @unique
  passwordHash String?

  tickets Ticket[]
}

model Conversation {
  id        String   @id @default(uuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id])
  channel   String   @default("whatsapp")
  createdAt DateTime @default(now())

  messages Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  direction      String       // inbound | outbound
  rawText        String
  mediaType      String       @default("text") // text | voice
  createdAt      DateTime     @default(now())

  intents Intent[]
}

model Intent {
  id         String   @id @default(uuid())
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id])
  type       String   // e.g. booking.extend_stay, housekeeping.clean_room
  params     String   @default("{}") // JSON-encoded
  confidence Float    @default(1.0)
  sentiment  String   @default("neutral")
  urgency    String   @default("normal")
  createdAt  DateTime @default(now())

  ticket     Ticket?
  reviewItem ReviewItem?
}

model Ticket {
  id               String       @id @default(uuid())
  intentId         String       @unique
  intent           Intent       @relation(fields: [intentId], references: [id])
  department       String       // reception | housekeeping | maintenance | guest_service
  status           String       @default("open") // open | in_progress | done
  assignedStaffId  String?
  assignedStaff    StaffMember? @relation(fields: [assignedStaffId], references: [id])
  summary          String
  slaDeadline      DateTime     // FR-10 — computed at creation from department + urgency
  escalatedAt      DateTime?    // FR-10 — set once when an open ticket passes slaDeadline
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  actions AgentAction[]
}

model AgentAction {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  agent     String   // reception | guest_service | housekeeping | executive_manager
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())
}

model ReviewItem {
  id           String    @id @default(uuid())
  intentId     String    @unique
  intent       Intent    @relation(fields: [intentId], references: [id])
  department   String    // reception | guest_service
  draftReply   String
  pendingAction String   // JSON-encoded {type, params}
  workflowRunId String?   // Mastra run to resume on approval; null for legacy-path rows
  status       String    @default("pending") // pending | approved | rejected
  reviewedBy   String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
}

model Review {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  source     String   @default("google")
  rating     Int
  text       String
  createdAt  DateTime @default(now())
}

// Domain events powering the live Operations Center feed (SSE) and
// incident replay. Append-only; seq is the SSE Last-Event-ID cursor.
model AltaEvent {
  id         String   @id @default(uuid())
  seq        BigInt   @default(autoincrement()) @unique
  propertyId String
  type       String
  payload    String   // JSON-encoded event body (typed via modules/events/types.ts)
  createdAt  DateTime @default(now())

  @@index([propertyId, seq])
}

// Tamper-evident audit trail. Append-only, and each row carries the hash
// of the one before it, so any deletion or edit of history breaks the
// chain verifiably (GET /api/audit/verify). This is the "who did what,
// when, and can you prove it wasn't altered" question every enterprise
// security review asks — and it matters here specifically because a
// review approval mutates a real reservation and messages a real guest.
model AuditEvent {
  id           String   @id @default(uuid())
  seq          BigInt   @default(autoincrement()) @unique
  propertyId   String?
  actorId      String?  // StaffMember id; null for system/unauthenticated
  actorName    String
  action       String   // e.g. auth.login, review.approve, ticket.status_change
  resourceType String?
  resourceId   String?
  outcome      String   @default("success") // success | failure
  metadata     String   @default("{}") // JSON — before/after, reason, etc.
  ip           String?
  userAgent    String?
  prevHash     String?  // hash of the previous entry, null for the first
  hash         String   // sha256 over this entry's canonical form + prevHash
  createdAt    DateTime @default(now())

  @@index([propertyId, seq])
  @@index([actorId, seq])
  @@index([action, seq])
}

// Per-property third-party credentials, encrypted at rest.
//
// These were global env vars, which is wrong before it is insecure: every
// hotel has its own Mews tokens, so one shared value cannot serve a
// multi-tenant deployment at all. Values are AES-256-GCM encrypted and
// never leave the server in plaintext — the API exposes which keys exist,
// never what they contain.
model PropertyCredential {
  id             String   @id @default(uuid())
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id])
  key            String   // e.g. mews.clientToken, whatsapp.cloudApiToken
  ciphertext     String   // base64 AES-256-GCM
  iv             String   // base64, unique per write
  authTag        String   // base64, detects tampering with the stored value
  lastRotatedAt  DateTime @default(now())
  lastAccessedAt DateTime?
  createdAt      DateTime @default(now())

  @@unique([propertyId, key])
  @@index([propertyId])
}
