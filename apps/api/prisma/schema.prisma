// ALTA MVP data model — mirrors the core entity set from the architecture doc.
// Postgres everywhere (dev via docker-compose's db service, prod the same
// image) so dev never drifts from what's actually deployed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// The tenancy root the brief mandates (§2, §10): each hotel account owns
// its plan, quota, users and data. A tenant may own several properties —
// hotel groups are the real customer shape.
model Tenant {
  id        String   @id @default(uuid())
  name      String
  plan      String   @default("basic") // basic | pro | enterprise
  status    String   @default("active") // active | suspended
  timezone  String   @default("Asia/Riyadh")
  language  String   @default("ar")
  quotaGb   Int      @default(10)
  usedBytes BigInt   @default(0)
  createdAt DateTime @default(now())

  properties Property[]
}

model Property {
  id          String   @id @default(uuid())
  // Filled by a BEFORE INSERT trigger when omitted (auto-provisions a
  // Tenant), so legacy write sites and tests keep working while the
  // column stays NOT NULL in the database as §10 requires.
  tenantId    String   @default("")
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  name        String
  pmsType     String   @default("mock")
  createdAt   DateTime @default(now())

  guests        Guest[]
  staff         StaffMember[]
  reservations  Reservation[]
  reviews       Review[]
  credentials   PropertyCredential[]
}

model Guest {
  id                String   @id @default(uuid())
  tenantId String @default("") // derived by DB trigger from the parent row
  propertyId        String
  property          Property @relation(fields: [propertyId], references: [id])
  whatsappId        String   @unique
  name              String?
  preferredDialect  String   @default("saudi")
  // The real PMS's own customer id (e.g. Mews CustomerId), once correlated.
  // Populated by a reservation-sync process, not by MewsPMSAdapter itself —
  // the Connector API has no way to look a customer up by phone number, so
  // this correlation has to happen in the PMS-to-app direction (importing
  // upcoming reservations) before a guest ever messages on WhatsApp. Null
  // until that sync exists; MewsPMSAdapter degrades gracefully when it is.
  externalId        String?  @unique
  createdAt         DateTime @default(now())

  reservations   Reservation[]
  conversations  Conversation[]
}

model Reservation {
  id          String   @id @default(uuid())
  tenantId String @default("") // derived by DB trigger from the parent row
  guestId     String
  guest       Guest    @relation(fields: [guestId], references: [id])
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  roomNumber  String
  checkIn     DateTime
  checkOut    DateTime
  status      String   @default("confirmed")
}

model StaffMember {
  id           String   @id @default(uuid())
  tenantId String @default("") // derived by DB trigger from the parent row
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id])
  name         String
  // Dashboard permission role (§3): alta_admin | hotel_manager |
  // general_manager | reception | maintenance_manager | technician |
  // marketing_manager. Legacy names are normalised at login.
  role         String
  // Ticket-routing department (reception | housekeeping | maintenance |
  // guest_service) — separate from role: a maintenance manager is not the
  // routing target for every fault, a technician is.
  department   String?
  onShift      Boolean  @default(true)
  whatsappId   String?
  // Dashboard login — both null means this staff record can't log in (e.g.
  // housekeeping/maintenance staff who only ever appear as a ticket
  // assignee, never open the Command Center themselves).
  username     String?  @unique
  passwordHash String?

  tickets Ticket[]
}

model Conversation {
  id        String   @id @default(uuid())
  tenantId String @default("") // derived by DB trigger from the parent row
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id])
  channel   String   @default("whatsapp")
  // §6-ب manual takeover: while true, no AI reply may be dispatched or
  // sent on this conversation — a human owns it. Only a manager may
  // return it to AI (enforced in the API).
  aiPaused    Boolean   @default(false)
  takenOverBy String?
  takenOverAt DateTime?
  createdAt DateTime @default(now())

  messages Message[]
}

model Message {
  id             String       @id @default(uuid())
  tenantId String @default("") // derived by DB trigger from the parent row
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  direction      String       // inbound | outbound
  rawText        String
  mediaType      String       @default("text") // text | voice
  createdAt      DateTime     @default(now())

  intents Intent[]
}

model Intent {
  id         String   @id @default(uuid())
  tenantId String @default("") // derived by DB trigger from the parent row
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id])
  type       String   // e.g. booking.extend_stay, housekeeping.clean_room
  params     String   @default("{}") // JSON-encoded
  confidence Float    @default(1.0)
  sentiment  String   @default("neutral")
  urgency    String   @default("normal")
  createdAt  DateTime @default(now())

  ticket     Ticket?
  reviewItem ReviewItem?
}

model Ticket {
  id               String       @id @default(uuid())
  tenantId String @default("") // derived by DB trigger from the parent row
  intentId         String       @unique
  intent           Intent       @relation(fields: [intentId], references: [id])
  department       String       // reception | housekeeping | maintenance | guest_service
  status           String       @default("open") // open | in_progress | done
  assignedStaffId  String?
  assignedStaff    StaffMember? @relation(fields: [assignedStaffId], references: [id])
  summary          String
  slaDeadline      DateTime     // FR-10 — computed at creation from department + urgency
  escalatedAt      DateTime?    // FR-10 — set once when an open ticket passes slaDeadline
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  actions AgentAction[]
}

model AgentAction {
  id        String   @id @default(uuid())
  tenantId String @default("") // derived by DB trigger from the parent row
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  agent     String   // reception | guest_service | housekeeping | executive_manager
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())
}

model ReviewItem {
  id           String    @id @default(uuid())
  tenantId String @default("") // derived by DB trigger from the parent row
  intentId     String    @unique
  intent       Intent    @relation(fields: [intentId], references: [id])
  department   String    // reception | guest_service
  draftReply   String
  pendingAction String   // JSON-encoded {type, params}
  workflowRunId String?   // Mastra run to resume on approval; null for legacy-path rows
  status       String    @default("pending") // pending | approved | rejected
  reviewedBy   String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
}

model Review {
  id         String   @id @default(uuid())
  tenantId String @default("") // derived by DB trigger from the parent row
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  source     String   @default("google")
  rating     Int
  text       String
  createdAt  DateTime @default(now())
}

// Domain events powering the live Operations Center feed (SSE) and
// incident replay. Append-only; seq is the SSE Last-Event-ID cursor.
model AltaEvent {
  id         String   @id @default(uuid())
  tenantId String @default("") // derived by DB trigger from the parent row
  seq        BigInt   @default(autoincrement()) @unique
  propertyId String
  type       String
  payload    String   // JSON-encoded event body (typed via modules/events/types.ts)
  createdAt  DateTime @default(now())

  @@index([propertyId, seq])
}

// Tamper-evident audit trail. Append-only, and each row carries the hash
// of the one before it, so any deletion or edit of history breaks the
// chain verifiably (GET /api/audit/verify). This is the "who did what,
// when, and can you prove it wasn't altered" question every enterprise
// security review asks — and it matters here specifically because a
// review approval mutates a real reservation and messages a real guest.
model AuditEvent {
  id           String   @id @default(uuid())
  tenantId String @default("") // derived by DB trigger from the parent row
  seq          BigInt   @default(autoincrement()) @unique
  propertyId   String?
  actorId      String?  // StaffMember id; null for system/unauthenticated
  actorName    String
  action       String   // e.g. auth.login, review.approve, ticket.status_change
  resourceType String?
  resourceId   String?
  outcome      String   @default("success") // success | failure
  metadata     String   @default("{}") // JSON — before/after, reason, etc.
  ip           String?
  userAgent    String?
  prevHash     String?  // hash of the previous entry, null for the first
  hash         String   // sha256 over this entry's canonical form + prevHash
  createdAt    DateTime @default(now())

  @@index([propertyId, seq])
  @@index([actorId, seq])
  @@index([action, seq])
}

// Per-property third-party credentials, encrypted at rest.
//
// These were global env vars, which is wrong before it is insecure: every
// hotel has its own Mews tokens, so one shared value cannot serve a
// multi-tenant deployment at all. Values are AES-256-GCM encrypted and
// never leave the server in plaintext — the API exposes which keys exist,
// never what they contain.
model PropertyCredential {
  id             String   @id @default(uuid())
  tenantId String @default("") // derived by DB trigger from the parent row
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id])
  key            String   // e.g. mews.clientToken, whatsapp.cloudApiToken
  ciphertext     String   // base64 AES-256-GCM
  iv             String   // base64, unique per write
  authTag        String   // base64, detects tampering with the stored value
  lastRotatedAt  DateTime @default(now())
  lastAccessedAt DateTime?
  createdAt      DateTime @default(now())

  @@unique([propertyId, key])
  @@index([propertyId])
}

// §5: file metadata lives here; bytes live in object storage. Nothing is
// ever public — reads and writes go through short-lived signed URLs.
model StorageFile {
  id         String    @id @default(uuid())
  tenantId   String    @default("") // derived by DB trigger from the parent row
  propertyId String
  kind       String    // fault_photo | content_media | post_image | policy_doc | ticket_attachment
  path       String    @unique // {propertyId}/{kind}/{yyyy}/{mm}/{id}-{name}
  name       String
  mime       String
  sizeBytes  BigInt
  ownerId    String?   // StaffMember who uploaded
  status     String    @default("pending") // pending | active | trashed | deleted
  trashedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([propertyId, kind])
  @@index([tenantId])
  @@index([status, trashedAt])
}

// §6-ج / §11-5: work orders are not tickets renamed — they carry
// assignment, a checklist, photo evidence, and a manager-gated close for
// critical faults. A WO may originate from a ticket (guest-reported) or
// be raised directly by staff.
model WorkOrder {
  id         String    @id @default(uuid())
  tenantId   String    @default("") // derived by DB trigger
  propertyId String
  ticketId   String?   // guest-reported origin, when there is one
  title      String
  category   String    // electrical | plumbing | hvac | furniture | other
  priority   String    @default("normal") // critical | high | normal | low
  status     String    @default("new") // new | assigned | in_progress | awaiting_confirm | closed
  assigneeId String?
  location   String    // room / area, free text ("غرفة 204")
  checklist  Json      @default("[]") // [{item, done}]
  createdBy  String
  closedBy   String?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  updates WorkOrderUpdate[]

  @@index([propertyId, status])
  @@index([assigneeId, status])
  @@index([tenantId])
}

// Progress notes on a work order; photos reference Phase 4 storage files
// (before/after evidence — §4 لوحة الصيانة).
model WorkOrderUpdate {
  id           String    @id @default(uuid())
  tenantId     String    @default("") // derived by DB trigger
  workOrderId  String
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id])
  authorId     String
  authorName   String
  note         String
  photoFileIds Json      @default("[]") // StorageFile ids
  statusTo     String?   // set when this update changed the WO status
  createdAt    DateTime  @default(now())

  @@index([workOrderId])
  @@index([tenantId])
}

// §6-أ / §7: agents answer ONLY from approved knowledge. Draft and retired
// items are invisible to the pipeline by construction (status filter in
// the one query that feeds agents).
model KnowledgeItem {
  id         String   @id @default(uuid())
  tenantId   String   @default("") // derived by DB trigger
  propertyId String
  title      String
  contentAr  String
  contentEn  String   @default("")
  tags       Json     @default("[]") // matching keywords, ar + en
  status     String   @default("draft") // draft | approved | retired
  approvedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([propertyId, status])
  @@index([tenantId])
}

// §4 مركز الوكلاء: the per-hotel on/off switch and config for each agent.
// No row means enabled with defaults — the pipeline must keep working for
// hotels that never opened the agent centre.
model AgentPolicy {
  id         String   @id @default(uuid())
  tenantId   String   @default("") // derived by DB trigger
  propertyId String
  agentKey   String
  enabled    Boolean  @default(true)
  config     Json     @default("{}")
  updatedBy  String?
  updatedAt  DateTime @updatedAt

  @@unique([propertyId, agentKey])
  @@index([tenantId])
}

// §9: every agent invocation captured — inputs, outputs, tools touched,
// which policy applied, and how long it took. The run log behind the
// agent centre.
model AgentRun {
  id            String   @id @default(uuid())
  tenantId      String   @default("") // derived by DB trigger
  propertyId    String
  agentKey      String
  intentId      String?
  intentType    String
  inputs        Json     @default("{}")
  outputs       Json     @default("{}")
  tools         Json     @default("[]")
  policyApplied String   @default("enabled") // enabled | disabled_skipped | auto_approved | queued_for_review
  durationMs    Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([propertyId, agentKey, createdAt])
  @@index([tenantId])
}

// §6-د / §8: linked social/review platform accounts. The OAuth token
// itself lives in the credential vault (PropertyCredential, AES-256-GCM,
// never shown) — this row holds only the non-secret linkage.
model SocialAccount {
  id         String    @id @default(uuid())
  tenantId   String    @default("") // derived by DB trigger
  propertyId String
  platform   String    // google | instagram | facebook | tiktok
  accountRef String    // the platform's location/page id
  status     String    @default("linked") // linked | expired | revoked
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([propertyId, platform])
  @@index([tenantId])
}

// §6-د / §11-6: fetched Google reviews with classification and the
// human-gated reply flow. No auto-publish in v1 (§7) — replyStatus can
// only reach published through an explicit approval.
model GoogleReview {
  id          String    @id @default(uuid())
  tenantId    String    @default("") // derived by DB trigger
  propertyId  String
  externalId  String
  stars       Int
  text        String
  author      String
  reviewedAt  DateTime
  sentiment   String    @default("neutral") // positive | neutral | negative
  topic       String    @default("general") // cleanliness | staff | food | facilities | value | safety | general
  draftReply  String    @default("")
  replyStatus String    @default("none") // none | draft | approved | published
  approvedBy  String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([propertyId, externalId])
  @@index([propertyId, replyStatus])
  @@index([tenantId])
}

// §6-هـ step 1: the brand identity that grounds every generated idea and
// draft — services, offers, audience, tone. One per property.
model BrandProfile {
  id         String   @id @default(uuid())
  tenantId   String   @default("") // derived by DB trigger
  propertyId String   @unique
  identity   String   @default("") // who the hotel is, in its own words
  services   Json     @default("[]")
  offers     Json     @default("[]")
  audience   String   @default("")
  tone       String   @default("ودّي واحترافي") // the voice guests hear
  language   String   @default("ar") // ar | en | both
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
}

// §6-هـ / §11-7: one piece of social content through its whole life.
// The §7 gate: status can only reach published through approved — the
// transition table in the service is the enforcement, tested.
model ContentItem {
  id           String    @id @default(uuid())
  tenantId     String    @default("") // derived by DB trigger
  propertyId   String
  idea         String
  bodyAr       String    @default("")
  bodyEn       String    @default("")
  mediaFileIds Json      @default("[]") // Phase 4 storage files
  channel      String    // instagram | facebook | tiktok
  status       String    @default("idea") // idea | draft | in_review | approved | scheduled | published | failed | rejected
  approvedBy   String?
  scheduledAt  DateTime?
  publishedAt  DateTime?
  resultUrl    String    @default("")
  metrics      Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([propertyId, status])
  @@index([status, scheduledAt])
  @@index([tenantId])
}

// §6-هـ extended: one row per channel a hotel actually operates. Settings,
// posting calendar, and analytics all hang off this — a hotel's Instagram
// cadence has nothing to do with its LinkedIn cadence, so they are separate
// rows, not one global config.
model SocialChannel {
  id             String    @id @default(uuid())
  tenantId       String    @default("") // derived by DB trigger
  propertyId     String
  channel        String    // instagram | tiktok | x | linkedin | ... (see CHANNEL_CATALOGUE)
  handle         String    @default("")
  enabled        Boolean   @default(false)
  autoPublish    Boolean   @default(false) // §7: false means every post needs approval
  postsPerWeek   Int       @default(3)
  bestTimes      Json      @default("[]") // ["19:00","21:30"] local
  tone           String    @default("")   // per-channel voice; TikTok ≠ LinkedIn
  hashtags       Json      @default("[]")
  audienceNote   String    @default("")
  // Connection state — set by the connect flow, never by hand. The token
  // itself lives in the credential vault; only this non-secret linkage
  // lives here.
  connected      Boolean   @default(false)
  connectedAt    DateTime?
  connectedBy    String?
  accountRef     String    @default("") // page/channel/account id at the platform
  connectionError String   @default("")
  lastSyncedAt   DateTime?
  followers      Int       @default(0)
  reach30d       Int       @default(0)
  engagement30d  Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([propertyId, channel])
  @@index([tenantId])
}

// §6-د extended: a complaint captured BEFORE it becomes a public review.
// The whole point is the window between "guest is unhappy" and "guest
// tells the internet" — this model exists to make that window actionable.
model ComplaintCase {
  id            String    @id @default(uuid())
  tenantId      String    @default("") // derived by DB trigger
  propertyId    String
  guestId       String?
  conversationId String?
  source        String    @default("whatsapp") // whatsapp | review | staff
  text          String
  category      String    @default("general") // cleanliness|staff|noise|food|facilities|billing|safety|general
  severity      String    @default("medium")  // low | medium | high | critical
  reputationRisk Int      @default(0)         // 0-100: how likely this becomes a public review
  status        String    @default("open")    // open | investigating | action_planned | resolved | escalated
  // Root cause analysis
  rcaWhy        Json      @default("[]")      // the five whys, as answered
  rootCause     String    @default("")
  contributing  Json      @default("[]")
  // Action plan
  actions       Json      @default("[]")      // [{action, owner, dueAt, done}]
  preventive    String    @default("")        // what stops the NEXT one
  ownerId       String?
  resolvedAt    DateTime?
  resolutionNote String   @default("")
  publicReviewId String?                      // set if it escaped and became public anyway
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([propertyId, status])
  @@index([propertyId, severity])
  @@index([tenantId])
}
